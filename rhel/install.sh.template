set -eu

DRIVER_ARCH=${TARGETARCH/amd64/x86_64} && DRIVER_ARCH=${DRIVER_ARCH/arm64/aarch64}
echo "DRIVER_ARCH is $DRIVER_ARCH"
RHEL_MAJOR=$(. /etc/os-release && echo "${VERSION_ID%%.*}")

dep_installer () {
  dnf install -y --setopt=install_weak_deps=False \
      libglvnd-glx \
      ca-certificates \
      curl-minimal \
      gcc \
      glibc \
      make \
      cpio \
      file \
      kmod

  # 32-bit glibc compat needed by nvidia-installer (dropped in RHEL 10)
  if [ "$DRIVER_ARCH" = "x86_64" ] && [ "$RHEL_MAJOR" -lt 10 ]; then
    dnf install -y --setopt=install_weak_deps=False glibc.i686
  fi

  if ! dnf install -y 'dnf-command(config-manager)'; then
    dnf install -y dnf5-plugins
  fi

  OS_RELEASE_ID=$(grep -oP '(?<=^ID=).+' /etc/os-release | tr -d '"')
  if [ "$OS_RELEASE_ID" = "rocky" ]; then
    dnf config-manager --set-enabled crb
  elif [ "$OS_RELEASE_ID" = "rhel" ]; then
    dnf config-manager --set-enabled codeready-builder-for-rhel-@@RHEL_MAJOR@@-${DRIVER_ARCH}-rpms || true
  fi

  # unzboot is needed to decompress zboot-format kernel images at runtime
  rpm --import https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-@@RHEL_MAJOR@@
  dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-@@RHEL_MAJOR@@.noarch.rpm
  dnf config-manager --enable epel
  dnf install -y --setopt=install_weak_deps=False unzboot

  dnf clean all
}

nvidia_installer () {
  if [ "$DRIVER_ARCH" = "x86_64" ]; then
    ./nvidia-installer --silent \
                       --no-kernel-module \
                       --install-compat32-libs \
                       --no-nouveau-check \
                       --no-nvidia-modprobe \
                       --no-rpms \
                       --no-backup \
                       --no-check-for-alternate-installs \
                       --no-libglx-indirect \
                       --no-install-libglvnd \
                       --x-prefix=/tmp/null \
                       --x-module-path=/tmp/null \
                       --x-library-path=/tmp/null \
                       --x-sysconfig-path=/tmp/null
  elif [ "$DRIVER_ARCH" = "ppc64le" ]; then
    ./nvidia-installer --silent \
                       --no-kernel-module \
                       --no-nouveau-check \
                       --no-nvidia-modprobe \
                       --no-rpms \
                       --no-backup \
                       --no-check-for-alternate-installs \
                       --no-libglx-indirect \
                       --no-install-libglvnd \
                       --x-prefix=/tmp/null \
                       --x-module-path=/tmp/null \
                       --x-library-path=/tmp/null \
                       --x-sysconfig-path=/tmp/null
  elif [ "$DRIVER_ARCH" = "aarch64" ]; then
    ./nvidia-installer --silent \
                       --no-kernel-module \
                       --no-nouveau-check \
                       --no-nvidia-modprobe \
                       --no-rpms \
                       --no-backup \
                       --no-check-for-alternate-installs \
                       --no-libglx-indirect \
                       --no-install-libglvnd \
                       --x-prefix=/tmp/null \
                       --x-module-path=/tmp/null \
                       --x-library-path=/tmp/null \
                       --x-sysconfig-path=/tmp/null
  else
    echo "DRIVER_ARCH doesn't match a known arch target"
  fi
}

fabricmanager_install() {
  dnf install -y --setopt=install_weak_deps=False nvidia-fabricmanager-${DRIVER_VERSION} nvidia-fabric-manager-devel-${DRIVER_VERSION}
  dnf versionlock add nvidia-fabricmanager nvidia-fabric-manager-devel
}

nscq_install() {
  dnf install -y --setopt=install_weak_deps=False libnvidia-nscq-${DRIVER_VERSION}
  dnf versionlock add libnvidia-nscq
}

# libnvsdm packages are not available for arm64
nvsdm_install() {
  if [ "$TARGETARCH" = "amd64" ]; then
    dnf install -y --setopt=install_weak_deps=False libnvsdm-${DRIVER_VERSION}
    dnf versionlock add libnvsdm
  fi
}

nvlink5_pkgs_install() {
  dnf install -y --setopt=install_weak_deps=False infiniband-diags nvlsm
}

imex_install() {
  dnf install -y --setopt=install_weak_deps=False nvidia-imex-${DRIVER_VERSION}
  dnf versionlock add nvidia-imex
}

extra_pkgs_install() {
  if [ "$DRIVER_TYPE" != "vgpu" ]; then
    # DNF module streams were removed in RHEL 10
    if [ "$RHEL_MAJOR" -lt 10 ]; then
      dnf module enable -y "nvidia-driver:${DRIVER_BRANCH}-open"
    fi
    dnf install -y 'dnf-command(versionlock)'

    fabricmanager_install
    nscq_install
    nvsdm_install
    nvlink5_pkgs_install
    imex_install
    rm -rf /usr/share/doc/*
    dnf clean all
  fi
}

setup_cuda_repo() {
    OS_ARCH=${TARGETARCH/amd64/x86_64} && OS_ARCH=${OS_ARCH/arm64/sbsa};
    dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel@@RHEL_MAJOR@@/${OS_ARCH}/cuda-rhel@@RHEL_MAJOR@@.repo
}

if [ "$1" = "nvinstall" ]; then
  nvidia_installer
elif [ "$1" = "depinstall" ]; then
  dep_installer
elif [ "$1" = "extrapkgsinstall" ]; then
  extra_pkgs_install
elif [ "$1" = "setup_cuda_repo" ]; then
  setup_cuda_repo
else
  echo "Unknown function: $1"
fi
